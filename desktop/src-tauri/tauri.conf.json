{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Font Builder Alpha",
  "version": "0.1.0-5",
  "identifier": "dev.weebsky.fontbuilder.alpha",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{
      "label": "main",
      "title": "Font Builder Alpha",
      "width": 1024,
      "height": 760,
      "minWidth": 820,
      "minHeight": 680,
      "dragDropEnabled": true,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["engine/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
